<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lawnops.irrigation-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/plugins/data/lawnops-mrlesmithjr-mcp/venv/bin/lawnops</string>
        <string>irrigation</string>
        <string>check</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/lawnops/irrigation-check.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/lawnops/irrigation-check.log</string>
</dict>
</plist>
