<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lawnops.irrigation-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/plugins/data/lawnops-mrlesmithjr-mcp/venv/bin/lawnops</string>
        <string>db</string>
        <string>sync-irrigation</string>
        <string>--days</string>
        <string>7</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/lawnops/irrigation-sync.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/lawnops/irrigation-sync.log</string>
</dict>
</plist>
