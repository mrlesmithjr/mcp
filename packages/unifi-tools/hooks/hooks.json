{
  "description": "Install or update the tool venv on session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/install_deps.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
