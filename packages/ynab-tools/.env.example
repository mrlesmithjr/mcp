# Get your YNAB Personal Access Token at:
# https://app.ynab.com/settings/developer
YNAB_ACCESS_TOKEN=your-token-here

# Find your plan ID via: ynab payee plans (or https://api.ynab.com/v1/plans)
# Also accepts YNAB_BUDGET_ID for backward compatibility
YNAB_PLAN_ID=your-plan-id-here

# Optional: plan name for display purposes
YNAB_PLAN_NAME=My Plan

# Optional: override data directory (default: ~/.local/share/ynab-tools/)
# YNAB_DATA_DIR=/path/to/custom/dir

# ── Income analysis (ynab income) ──
# Regular semi-monthly paycheck amount (for bonus detection)
# YNAB_REGULAR_PAY=5000.00
# Paychecks above this amount are flagged as containing a bonus
# YNAB_BONUS_THRESHOLD=8000.00
# Comma-separated employer payee names for paycheck identification (partial match)
# YNAB_PAYCHECK_PAYEES=My Employer

# ── Paycheck forecast (ynab paycheck) ──
# Comma-separated payee names to identify as income sources (partial match).
# If unset, auto-detects from recurring inflow patterns.
# YNAB_INCOME_PAYEES=My Employer,Side Gig LLC

# ── Retirement tracking (ynab retirement) ──
# YNAB account names for retirement accounts (must match exactly)
# YNAB_RETIREMENT_401K=Your 401(k) Account Name
# YNAB_RETIREMENT_ROTH_IRA=Your Roth IRA Account Name
# YNAB_RETIREMENT_TRAD_IRA=Your Traditional IRA Account Name
# YNAB_RETIREMENT_TAXABLE=Your Taxable Brokerage Account Name
# Birth year for age-based projections
# YNAB_BIRTH_YEAR=1980
# Custom projection milestones (age:label pairs, comma-separated)
# YNAB_RETIREMENT_MILESTONES=67:Target retirement,62:Early retirement eligible

# ── Budget health ratios (ynab budget) ──
# Annual gross base salary (enables health ratios section in budget check)
# YNAB_GROSS_SALARY=100000
# Annual gross OTE including bonuses (optional, adds OTE% column)
# YNAB_GROSS_OTE=150000
# Annual total retirement contributions (optional, adds retirement ratio row)
# YNAB_RETIREMENT_ANNUAL=30000
# Category name fragments for ratio calculations (comma-separated, partial match)
# YNAB_RATIO_HOUSING=Mortgage & Rent
# YNAB_RATIO_AUTO=Auto Loan
# YNAB_RATIO_DEBT=Mortgage & Rent,Auto Loan,Student Loan

# ── Month-end report (ynab month-end) ──
# Category group fragments to treat as protected (excluded from surplus list)
# YNAB_PROTECTED_GROUPS=Emergency,Savings,Retirement,Holding,Investment
# Exact category names to treat as protected
# YNAB_PROTECTED_NAMES=Emergency Fund,Roth IRA,Holding: Next Month

# ── Fidelity positions import (ynab import positions) ──
# Map Fidelity account numbers to YNAB account search terms (JSON)
# YNAB_FIDELITY_ACCOUNTS={"ACCT123": "Roth IRA", "ACCT456": "Taxable Brokerage"}
