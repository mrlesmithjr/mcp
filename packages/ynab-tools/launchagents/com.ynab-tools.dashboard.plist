<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.ynab-tools.dashboard</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.claude/plugins/data/ynab-tools-mrlesmithjr-mcp/venv/bin/ynab-dashboard</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8000</string>
		<string>--sync-interval</string>
		<string>60</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/share/ynab-tools/dashboard.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/share/ynab-tools/dashboard.log</string>
</dict>
</plist>
